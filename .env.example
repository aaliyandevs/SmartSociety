# ─────────────────────────────────────────────────────────────
# SmartSociety — environment configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (PostgreSQL 14+).
#
# Option A — use the bundled local server (`npm run db:up`), no install needed:
DATABASE_URL="postgresql://smartsociety:smartsociety@127.0.0.1:5433/smartsociety?schema=public"
#
# Option B — your own PostgreSQL instance:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Secret used to sign session cookies (JWT / HS256).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-characters"

# Session lifetime in seconds (default 8 hours).
AUTH_SESSION_TTL="28800"

# Public base URL of the application (used for QR pass deep links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Society branding shown across the UI and on generated PDF receipts.
NEXT_PUBLIC_SOCIETY_NAME="Green Meadows Residency"

# Directory (relative to project root) where uploaded complaint photos are stored.
UPLOAD_DIR="uploads"

# Max upload size in bytes (default 5 MB).
UPLOAD_MAX_BYTES="5242880"

# ── Local embedded PostgreSQL (only used by `npm run db:up`) ──
LOCAL_PG_PORT="5433"
LOCAL_PG_USER="smartsociety"
LOCAL_PG_PASSWORD="smartsociety"
LOCAL_PG_DATABASE="smartsociety"
