# dependencies
/node_modules
.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts.bak

# production
/build
/dist

# local database cluster created by `npm run db:up`
/.postgres/

# runtime uploads (complaint photos, visitor snapshots)
/uploads/*
!/uploads/.gitkeep

# testing
/coverage
/test-results
/playwright-report
/blob-report
/.playwright
# saved Playwright sessions — real credentials, never commit
/tests/e2e/.auth

# env files — never commit real secrets
.env
.env.local
.env.*.local

# submission deliverables — not part of the deployable app
*.pdf
*.docx
*.mp4

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vscode/*
!.vscode/extensions.json
.idea
tsconfig.tsbuildinfo
